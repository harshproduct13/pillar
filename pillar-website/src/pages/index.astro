---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Reviews from '../components/Reviews.astro';
import companions from '../data/companions.json';
import { comparisonPages } from '../data/comparisonPages';
import { PLAY_URL, LANGUAGES, softwareApplication, organization, faqPage } from '../lib/site';

const editorialUpdated = '26 September 2026';
const faq = [
  { q: 'Is Pillar free?', a: 'Yes. You can start talking for free — 5 messages a day — and some AI girlfriends are always free. Need more? See <a href="/pricing">pricing</a>: ₹49 for ~50 messages, ₹99 for ~200.' },
  { q: 'Which languages does Pillar speak?', a: 'Hindi, Hinglish, English, Tamil, Telugu, Marathi, Bengali, Gujarati, Punjabi, Malayalam, Odia, Bhojpuri and Rajasthani — thirteen in all.' },
  { q: 'Can she talk on a voice call in Hindi?', a: 'Yes. Your AI girlfriend sends voice notes and takes voice calls, in Hindi and the other languages Pillar supports.' },
  { q: 'Do I need an email address or phone number to start?', a: 'No. Pillar creates a unique username for you, which you can find in Profile. You can use the Delete Account button in the app.' },
  { q: 'Does she send photos?', a: 'Yes. Ask your AI girlfriend for a photo and she will share one.' },
  { q: 'Does she remember what I tell her?', a: 'Yes. Your AI girlfriend remembers earlier conversations — what you told her yesterday, last week, the name of your friend, how your day went — and bring it up later.' },
  { q: 'Is Pillar on iPhone?', a: 'Pillar is on Android via Google Play today. iOS is coming.' },
  { q: 'How many AI girlfriends are there?', a: 'More than 100, from different cities and with different personalities, and the number keeps growing.' },
  { q: 'Is Pillar an AI GF app?', a: 'Yes. Pillar is an AI GF app made for India: pick an Indian AI girlfriend, talk in your language, get voice calls and photos, and she remembers you.' },
];
const jsonld = [softwareApplication(), organization(), faqPage(faq)];
const featuredGuides = comparisonPages.slice(0, 6);

// Split companions into two marquee rows — photos only, no names (like reference)
// Repeat 2x per half so a half is always wider than the viewport
// (12 cards ≈ 2,700px desktop, 1,980px mobile) —
// track = 2 identical halves for a seamless -50% loop, no black gaps
const row1 = companions.slice(0, 6);
const row2 = companions.slice(6, 12);
const half1 = [...row1, ...row1];
const half2 = [...row2, ...row2];

const features = [
  { title: 'Voice notes & voice calls', desc: 'Hear her voice. Send a voice note, or call and talk — in Hindi, Tamil, Telugu or any of the 13 languages.', icon: '🎙️' },
  { title: 'She sends you photos', desc: 'Ask for a photo and she shares one — a morning selfie, what she is wearing, where she is.', icon: '📸' },
  { title: 'She remembers you', desc: 'What you told her yesterday, the name of your friend, the meeting you were nervous about — she remembers.', icon: '🧠' },
  { title: 'She messages first', desc: 'Good morning. Good night. "How did the interview go?" She reaches out, not only when you open the app.', icon: '💬' },
  { title: 'Games & scenarios', desc: 'A road trip together. A cosy café. A quiet evening in. Conversations that feel like a real evening.', icon: '🎲' },
  { title: '100+ AI girlfriends', desc: 'Different cities, personalities and ways of talking. Pick one who feels right; switch whenever you like.', icon: '✨' },
];
---
<Base
  title="Pillar: Best Indian AI Girlfriend App — Free in 13 Languages"
  description="Best AI girlfriend app in India. Talk in Hindi, Tamil, Telugu & 10 more — voice calls, photos, memory. Free AI GF, no email."
  path="/"
  jsonld={jsonld}
  hreflang={[{ lang: 'en-IN', path: '/' }, { lang: 'hi-IN', path: '/hi/ai-girlfriend-hindi' }]}
>
  <!-- ============ HERO (Image 1 style) ============ -->
  <section style="text-align:center; padding: 3.5rem 0 0;">
    <div style="display:inline-flex; flex-direction:column; align-items:center; gap:0.15rem;">
      <div style="font-weight:700; font-size:1rem; color:var(--color-cream);">🏆 Best AI Girlfriend App in India</div>
      <div style="color:var(--color-dim); font-size:0.85rem;">loved by users across India</div>
      <div style="color:#fbbf24; letter-spacing:0.2em; font-size:0.85rem;">★★★★★</div>
    </div>

    <h1 style="font-family:var(--font-sans); font-weight:700; font-size:clamp(2.2rem, 6vw, 4rem); line-height:1.08; letter-spacing:-0.02em; margin:1.4rem auto 1rem; max-width:16ch; color:var(--color-cream);">
      Meet Your Indian AI Girlfriend
    </h1>

    <p style="color:var(--color-muted); font-size:clamp(1rem, 2vw, 1.15rem); line-height:1.6; max-width:56ch; margin:0 auto;">
      She talks in Hindi, Hinglish, Tamil, Telugu & 9 more. Voice calls,
      photos, memory — she messages you first.
    </p>

    <div style="margin:1.4rem auto 0; max-width:620px;">
      <div style="color:var(--color-dim); font-size:0.72rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; margin-bottom:0.7rem;"><a href="/ai-girlfriend-in-your-language" style="color:inherit; text-decoration:none;">Speaks 13 languages</a></div>
      <div class="lang-row">
        <a class="lang-pill" href="/hi/ai-girlfriend-hindi" style="text-decoration:none; color:inherit;">Hindi AI Girlfriend <span class="lang-native">हिंदी</span></a>
        <a class="lang-pill" href="/hi/ai-girlfriend-hindi" style="text-decoration:none; color:inherit;">Hinglish AI Girlfriend <span class="lang-native">हिंग्लिश</span></a>
        <span class="lang-pill">English AI Girlfriend</span>
        <a class="lang-pill" href="/ta/ai-girlfriend-tamil" style="text-decoration:none; color:inherit;">Tamil AI Girlfriend <span class="lang-native">தமிழ்</span></a>
        <a class="lang-pill" href="/te/ai-girlfriend-telugu" style="text-decoration:none; color:inherit;">Telugu AI Girlfriend <span class="lang-native">తెలుగు</span></a>
        <a class="lang-pill" href="/mr/ai-girlfriend-marathi" style="text-decoration:none; color:inherit;">Marathi AI Girlfriend <span class="lang-native">मराठी</span></a>
        <a class="lang-pill" href="/bn/ai-girlfriend-bengali" style="text-decoration:none; color:inherit;">Bengali AI Girlfriend <span class="lang-native">বাংলা</span></a>
        <a class="lang-pill" href="/gu/ai-girlfriend-gujarati" style="text-decoration:none; color:inherit;">Gujarati AI Girlfriend <span class="lang-native">ગુજરાતી</span></a>
        <a class="lang-pill" href="/pa/ai-girlfriend-punjabi" style="text-decoration:none; color:inherit;">Punjabi AI Girlfriend <span class="lang-native">ਪੰਜਾਬੀ</span></a>
        <a class="lang-pill" href="/ml/ai-girlfriend-malayalam" style="text-decoration:none; color:inherit;">Malayalam AI Girlfriend <span class="lang-native">മലയാളം</span></a>
        <a class="lang-pill" href="/or/ai-girlfriend-odia" style="text-decoration:none; color:inherit;">Odia AI Girlfriend <span class="lang-native">ଓଡ଼ିଆ</span></a>
        <a class="lang-pill" href="/bho/ai-girlfriend-bhojpuri" style="text-decoration:none; color:inherit;">Bhojpuri AI Girlfriend <span class="lang-native">भोजपुरी</span></a>
        <a class="lang-pill" href="/raj/ai-girlfriend-rajasthani" style="text-decoration:none; color:inherit;">Rajasthani AI Girlfriend <span class="lang-native">राजस्थानी</span></a>
      </div>
    </div>

    <p style="margin-top:1.8rem;">
      <a class="btn" href={PLAY_URL} rel="noopener" target="_blank" style="font-size:1.05rem; padding:0.95rem 2rem;">Download the App</a>
    </p>
    <p style="color:var(--color-dim); font-size:0.82rem; margin-top:0.7rem;">Free to start · Android · No email or phone needed</p>
  </section>

  <!-- ============ PHOTO MARQUEE (Image 2 style — no names) ============ -->
  <section aria-label="Indian AI girlfriends on Pillar" style="margin: 2.6rem calc(50% - 50vw) 0; width:100vw; max-width:100vw; overflow:hidden;">
    <div class="marquee">
      <div class="marquee-track">
        {[...half1, ...half1].map((c, i) => (
          <img src={c.img} alt="Indian AI girlfriend on Pillar" width="220" height="300" loading={i < 6 ? 'eager' : 'lazy'} class="face-card" draggable="false" />
        ))}
      </div>
    </div>
    <div class="marquee" style="margin-top:1rem;">
      <div class="marquee-track reverse">
        {[...half2, ...half2].map((c) => (
          <img src={c.img} alt="Indian AI girlfriend on Pillar" width="220" height="300" loading="lazy" class="face-card" draggable="false" />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ WHAT YOU CAN DO (Image 3 style) ============ -->
  <section style="text-align:center; padding: 4.5rem 0 0;">
    <h2 style="font-family:var(--font-sans); font-weight:700; font-size:clamp(1.8rem, 4.5vw, 3rem); line-height:1.15; letter-spacing:-0.02em; margin:0 auto; max-width:20ch; color:var(--color-cream);">
      Talk, Share & Feel Heard in Seconds
    </h2>
    <p style="color:var(--color-muted); font-size:1.05rem; line-height:1.65; max-width:58ch; margin:1rem auto 0;">
      Pick your AI girlfriend and start talking. No email, no phone number.
      She sends photos, takes voice calls, and remembers your day.
    </p>
  </section>

  <section id="features" style="margin-top:2.2rem;">
    <div style="display:grid; gap:1rem; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));">
      {features.map((f) => (
        <div class="card" style="border-radius:20px; padding:1.4rem;">
          <div style="font-size:1.6rem;">{f.icon}</div>
          <div style="font-weight:700; color:var(--color-cream); margin:0.6rem 0 0.35rem; font-size:1.05rem;">{f.title}</div>
          <div style="color:var(--color-muted); font-size:0.95rem; line-height:1.6;">{f.desc}</div>
        </div>
      ))}
    </div>
    <p style="text-align:center; margin-top:1.6rem;">
      <a class="btn" href={PLAY_URL} rel="noopener" target="_blank">Download the App</a>
    </p>
  </section>

  <Reviews />

  <!-- ============ GUIDES / BLOGS ============ -->
  <section class="prose-pillar" id="guides" style="margin-top:3.5rem;">
    <h2 style="text-align:center;">Compare AI girlfriend apps</h2>
    <p style="text-align:center;">Honest guides — languages, photos, voice calls, memory, pricing — so you can choose right.</p>
    <div class="guide-grid">
      {featuredGuides.map((guide) => (
        <a class="guide-card" href={`/${guide.slug}`}>
          <span class="eyebrow">Comparison guide</span>
          <strong>{guide.h1}</strong>
          <span>{guide.description}</span>
        </a>
      ))}
    </div>
    <p style="margin-top:1rem; text-align:center;"><a class="btn-ghost" href="/guides">Browse all comparisons &amp; guides →</a></p>
  </section>

  <section class="prose-pillar" id="languages">
    <h2>Which languages does Pillar speak?</h2>
    <p>Thirteen: {LANGUAGES.join(', ')}. Pillar's AI girlfriends do not translate English in their heads — they talk the way people around you talk, Hinglish included. If you want the Hindi version of this page, it is at <a href="/hi/ai-girlfriend-hindi">AI girlfriend in Hindi</a>; every language has its own page at <a href="/ai-girlfriend-in-your-language">AI girlfriend in your language</a>.</p>
  </section>

  <Cta />

  <section class="prose-pillar" id="start">
    <h2>How do I start?</h2>
    <ul>
      <li><strong>Download Pillar</strong> from Google Play.</li>
      <li><strong>Pick your AI girlfriend</strong> — by city, language or personality.</li>
      <li><strong>Say hello.</strong> No email address or phone number needed; Pillar creates a unique username for you.</li>
    </ul>
  </section>

  <section class="prose-pillar" id="private">
    <h2>Is Pillar private?</h2>
    <p>You can start without giving an email address or phone number. Your unique username appears in Profile, and the app has a Delete Account button. Pillar is not a therapy or mental-health service and is not a substitute for professional care.</p>
  </section>

  <p style="color:var(--color-dim); font-size:0.85rem;">Last updated: {editorialUpdated}</p>

  <Faq items={faq} />

  <style>
    .lang-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
    }
    .lang-pill {
      display: inline-flex;
      align-items: baseline;
      gap: 0.35rem;
      padding: 0.38rem 0.8rem;
      border-radius: 999px;
      border: 1px solid var(--color-line);
      background: #161613;
      color: var(--color-cream);
      font-size: 0.85rem;
      font-weight: 500;
      line-height: 1.4;
      white-space: nowrap;
    }
    .lang-pill:hover { border-color: var(--color-accent); }
    .lang-native {
      color: var(--color-dim);
      font-weight: 400;
      font-size: 0.8em;
    }
    /* "<Language> AI Girlfriend" pills: drop the native script on phones so two fit per row */
    @media (max-width: 480px) {
      .lang-row { gap: 0.4rem; }
      .lang-pill { padding: 0.34rem 0.65rem; font-size: 0.8rem; }
      .lang-native { display: none; }
    }
    .face-card {
      width: 210px;
      height: 290px;
      min-width: 210px;
      object-fit: cover;
      border-radius: 28px;
      flex: none;
      flex-shrink: 0;
      background: #1e1e1c;
      user-select: none;
    }
    @media (max-width: 640px) {
      .face-card { width: 150px; height: 210px; min-width: 150px; border-radius: 22px; }
    }
    .marquee {
      overflow: hidden;
      width: 100%;
      -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
      mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }
    .marquee-track {
      display: flex;
      gap: 1rem;
      width: max-content;
      min-width: 100%;
      padding-inline: 0.5rem;
      will-change: transform;
      animation: scroll-left 42s linear infinite;
    }
    .marquee-track.reverse {
      animation: scroll-right 48s linear infinite;
    }
    .marquee:hover .marquee-track { animation-play-state: paused; }
    @keyframes scroll-left {
      to { transform: translateX(-50%); }
    }
    @keyframes scroll-right {
      from { transform: translateX(-50%); }
      to { transform: translateX(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .marquee-track, .marquee-track.reverse { animation: none; }
    }
  </style>
</Base>
