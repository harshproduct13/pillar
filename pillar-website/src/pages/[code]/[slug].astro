---
// /<code>/<slug>: the per-language AI girlfriend pages, the free-tool pages in that language (D-61),
// and each language's tools hub. One route so the three kinds of page cannot collide.
import LanguagePageView from '../../components/LanguagePageView.astro';
import ToolView from '../../components/tools/ToolView.astro';
import HubView from '../../components/tools/HubView.astro';
import { languagePages } from '../../data/languagePages';
import { allToolPages } from '../../data/tools';
import { LANGS } from '../../data/tools/types';

export function getStaticPaths() {
  return [
    ...languagePages.map((p) => ({ params: { code: p.code, slug: p.slug }, props: { kind: 'language', page: p } })),
    ...allToolPages.filter((p) => p.lang !== 'en').map((p) => ({ params: { code: p.lang, slug: p.slug }, props: { kind: 'tool', page: p } })),
    ...LANGS.filter((l) => l !== 'en').map((l) => ({ params: { code: l, slug: 'tools' }, props: { kind: 'hub', lang: l } })),
  ];
}
const props = Astro.props as any;
---
{props.kind === 'language' && <LanguagePageView page={props.page} />}
{props.kind === 'tool' && <ToolView page={props.page} />}
{props.kind === 'hub' && <HubView lang={props.lang} />}
