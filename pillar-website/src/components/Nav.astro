---
import { PLAY_URL } from '../lib/site';
const { lang = 'en' } = Astro.props;
const links = [
  { href: '/best-ai-girlfriend-apps-india', label: 'Best in India' },
  { href: '/character-ai-alternatives-india', label: 'Character AI alternatives' },
  { href: '/apps-like-replika-india', label: 'Apps like Replika' },
  { href: '/hi/ai-girlfriend-hindi', label: 'हिंदी' },
  { href: '/about', label: 'About' },
];
---
<header style="border-bottom: 1px solid var(--color-line);">
  <div class="container" style="display:flex; align-items:center; justify-content:space-between; gap:1rem; padding-block: 0.9rem; flex-wrap: wrap;">
    <a href="/" style="display:flex; align-items:center; gap:0.6rem; text-decoration:none; color:var(--color-cream); font-weight:700;">
      <img src="/Logo%20Emblem.png" alt="" width="28" height="28" style="border-radius:6px" />
      <span>Pillar</span><span style="color:var(--color-dim); font-weight:500;">Indian AI Girlfriend</span>
    </a>
    <nav aria-label="Main" style="display:flex; gap:1rem; flex-wrap:wrap; font-size:0.92rem;">
      {links.map((l) => <a href={l.href} style="color:var(--color-muted); text-decoration:none;">{l.label}</a>)}
    </nav>
    <a class="btn" href={PLAY_URL} rel="noopener" target="_blank">Get it on Google Play</a>
  </div>
</header>
