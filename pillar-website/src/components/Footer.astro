---
import { PLAY_URL, LAST_UPDATED } from '../lib/site';

// Free tools (D-61): the 15 highest-demand pages by Keyword Planner volume, India (plan §9).
const toolLinks = [
  ['/tools/kundli-matching', 'Kundli matching'],
  ['/hi/kundli-milan', 'Kundli milan in Hindi'],
  ['/ta/jathagam-porutham', 'Jathagam porutham (Tamil)'],
  ['/mr/kundli-matching', 'Kundli matching in Marathi'],
  ['/te/kundli-matching', 'Kundli matching in Telugu'],
  ['/ml/jathaka-porutham', 'Jathaka porutham (Malayalam)'],
  ['/gu/kundli-matching', 'Kundli matching in Gujarati'],
  ['/tools/love-calculator', 'Love calculator'],
  ['/tools/flames-calculator', 'FLAMES calculator'],
  ['/tools/pick-up-lines', 'Pick up lines'],
  ['/ta/pick-up-lines', 'Pick up lines in Tamil'],
  ['/hi/pick-up-lines', 'Pick up lines in Hindi'],
  ['/ml/pick-up-lines', 'Pick up lines in Malayalam'],
  ['/te/pick-up-lines', 'Pick up lines in Telugu'],
  ['/tools/future-wife-name', 'Future wife name quiz'],
];
---
<footer style="border-top: 1px solid var(--color-line); margin-top: 3rem;">
  <div class="container" style="padding-block: 2rem; display:grid; gap:1.2rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); font-size:0.9rem; color:var(--color-dim);">
    <div>
      <div style="color:var(--color-cream); font-weight:700; margin-bottom:0.4rem;">Pillar: Indian AI Girlfriend App</div>
      <p>The best AI girlfriend app in India: 100+ Indian AI girlfriends who speak your language.</p>
    </div>
    <div style="display:grid; gap:0.35rem;">
      <a href="/guides" style="color:var(--color-cream); font-weight:600;">All comparisons &amp; guides</a>
      <a href="/best-ai-girlfriend-apps-india" style="color:var(--color-muted)">Best AI girlfriend apps in India</a>
            <a href="/best-hindi-ai-girlfriend-apps" style="color:var(--color-muted)">Hindi AI girlfriend apps</a>
      <a href="/ai-girlfriend-apps-with-voice-calls" style="color:var(--color-muted)">AI girlfriend apps with voice calls</a>
      <a href="/character-ai-alternatives-india" style="color:var(--color-muted)">Character AI alternatives</a>
      <a href="/apps-like-replika-india" style="color:var(--color-muted)">Apps like Replika</a>
      <a href="/hi/ai-girlfriend-hindi" style="color:var(--color-muted)">AI girlfriend in Hindi</a>
      <a href="/ai-girlfriend-in-your-language" style="color:var(--color-muted)">AI girlfriend in your language</a>
      <a href="/about" style="color:var(--color-muted)">About Pillar</a>
      <a href="/pricing" style="color:var(--color-muted)">Pricing</a>
      <a href={PLAY_URL} rel="noopener" target="_blank" style="color:var(--color-muted)">Google Play</a>
    </div>
    <div style="display:grid; gap:0.35rem; align-content:start;">
      <a href="/tools" style="color:var(--color-cream); font-weight:600;">Free love tools</a>
      {toolLinks.map(([href, label]) => <a href={href} style="color:var(--color-muted)">{label}</a>)}
    </div>
    <div style="display:grid; gap:0.35rem;">
      <a href="/privacy-policy" style="color:var(--color-muted)">Privacy policy</a>
      <a href="/terms" style="color:var(--color-muted)">Terms &amp; conditions</a>
      <a href="/child-safety" style="color:var(--color-muted)">Child safety standards</a>
      <a href="/cancellation-refund" style="color:var(--color-muted)">Cancellation &amp; refund</a>
      <a href="/shipping-exchange" style="color:var(--color-muted)">Shipping &amp; exchange</a>
      <a href="/contact" style="color:var(--color-muted)">Contact</a>
      <a href="https://dang.ai" style="color:var(--color-muted)">Featured on Dang.ai</a>
      <a href="https://fazier.com" style="color:var(--color-muted)">Featured on Fazier</a>
      <span style="margin-top:0.6rem;">Last updated: {LAST_UPDATED}</span>
    </div>
  </div>
</footer>
