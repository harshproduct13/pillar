---
import { PLAY_URL, LAST_UPDATED } from '../lib/site';
---
<footer style="border-top: 1px solid var(--color-line); margin-top: 3rem;">
  <div class="container" style="padding-block: 2rem; display:grid; gap:1.2rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); font-size:0.9rem; color:var(--color-dim);">
    <div>
      <div style="color:var(--color-cream); font-weight:700; margin-bottom:0.4rem;">Pillar: Indian AI Girlfriend</div>
      <p>An AI companion app with 100+ Indian companions. Made in India, for India. Android now; iOS coming.</p>
      <p style="margin-top:0.6rem;">Pillar is not a therapy or mental-health service and is not a substitute for professional care. If you are in crisis, contact a qualified professional or emergency services.</p>
    </div>
    <div style="display:grid; gap:0.35rem;">
      <a href="/best-ai-girlfriend-apps-india" style="color:var(--color-muted)">Best AI girlfriend apps in India</a>
      <a href="/character-ai-alternatives-india" style="color:var(--color-muted)">Character AI alternatives</a>
      <a href="/apps-like-replika-india" style="color:var(--color-muted)">Apps like Replika</a>
      <a href="/hi/ai-girlfriend-hindi" style="color:var(--color-muted)">AI girlfriend in Hindi</a>
      <a href="/about" style="color:var(--color-muted)">About Pillar</a>
      <a href={PLAY_URL} rel="noopener" target="_blank" style="color:var(--color-muted)">Google Play</a>
    </div>
    <div style="display:grid; gap:0.35rem;">
      <a href="/privacy-policy" style="color:var(--color-muted)">Privacy policy</a>
      <a href="/terms" style="color:var(--color-muted)">Terms &amp; conditions</a>
      <a href="/cancellation-refund" style="color:var(--color-muted)">Cancellation &amp; refund</a>
      <a href="/shipping-exchange" style="color:var(--color-muted)">Shipping &amp; exchange</a>
      <a href="/contact" style="color:var(--color-muted)">Contact</a>
      <span style="margin-top:0.6rem;">Last updated: {LAST_UPDATED}</span>
    </div>
  </div>
</footer>
