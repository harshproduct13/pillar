---
import { PLAY_URL } from '../lib/site';
const { text = 'Get Pillar on Google Play', sub = 'Free to start. No sign-up needed.' } = Astro.props;
---
<div class="card" style="display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin: 2rem 0;">
  <div><div style="font-weight:600; color:var(--color-cream);">{text}</div><div style="color:var(--color-dim); font-size:0.9rem;">{sub}</div></div>
  <a class="btn" href={PLAY_URL} rel="noopener" target="_blank">Open Google Play →</a>
</div>
