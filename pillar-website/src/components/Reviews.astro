---
import { reviews } from '../data/reviews';
interface Props { title?: string; only?: string[] }
const { title = 'What Pillar users say', only } = Astro.props;
const items = only ? reviews.filter((r) => only.includes(r.title)) : reviews;
---
<section class="prose-pillar" id="reviews" style="margin-top:3rem;">
  <h2 style="text-align:center;">{title}</h2>
  <div class="review-grid">
    {items.map((r) => (
      <figure class="review-card" lang={r.lang}>
        <div class="review-stars" aria-label="5 out of 5 stars">★★★★★</div>
        <figcaption class="review-title">{r.title}</figcaption>
        <blockquote>{r.text}</blockquote>
      </figure>
    ))}
  </div>
  <style>
    .review-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); margin-top: 1.2rem; }
    .review-card { margin: 0; border: 1px solid var(--color-line); border-radius: 20px; padding: 1.3rem 1.4rem; background: #13130f; }
    .review-stars { color: #fbbf24; letter-spacing: 0.15em; font-size: 0.95rem; }
    .review-title { color: var(--color-cream); font-weight: 700; font-size: 1.05rem; margin: 0.5rem 0 0.4rem; }
    .review-card blockquote { margin: 0; color: var(--color-muted); line-height: 1.6; font-size: 0.95rem; }
  </style>
</section>
